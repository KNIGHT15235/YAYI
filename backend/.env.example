# ==================== LLM & Embedding ====================
# 阿里云百炼 API Key（必填）
# 申请地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3-max

# 六角色科研 Agent 使用独立配置（OPENAI_MODEL 不控制这些角色）。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 留空保留混合模型默认值；设为模型名会覆盖六个角色，角色变量优先。
DEFAULT_MODEL=
ARCHITECT_MODEL=
SCOUT_MODEL=
DATA_ANALYST_MODEL=
WIZARD_MODEL=
WRITER_MODEL=
CRITIC_MODEL=
# 温度、输出额度和补检/修订温度在 app/config/llm_config.py 的 AgentsConfig 中维护。

# ==================== OpenRouter API ====================
# OpenRouter API Key（可选，用于多模型支持）
# 申请地址: https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key

# ==================== 文档解析 (DocMind) ====================
# 阿里云 DocMind 文档解析服务（可选）
# 申请地址: https://help.aliyun.com/zh/ram/user-guide/create-an-accesskey-pair
DOCMIND_ACCESS_KEY_ID=your-access-key-id
DOCMIND_ACCESS_KEY_SECRET=your-access-key-secret

# ==================== 搜索 API ====================
# 博查搜索 API（必填）
# 申请地址: https://open.bochaai.com/
BOCHA_API_KEY=your-bocha-api-key

# Serper 搜索 API（可选）
SERPER_API_KEY=your-serper-api-key

# ==================== 行业资讯 API ====================
# 聚合数据 - 股票行情 API（可选）
# 申请地址: https://www.juhe.cn/docs/api/id/21
JUHE_STOCK_API_KEY=your-juhe-stock-api-key

# ==================== 招投标 API ====================
# 阿里云市场 - 招投标信息 API（可选）
# 申请地址: https://market.aliyun.com/detail/cmapi00063550
BID_APP_KEY=your-bid-app-key
BID_APP_SECRET=your-bid-app-secret
BID_APP_CODE=your-bid-app-code

# ==================== Redis ====================
# Docker 默认配置，通常无需修改
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=

# ==================== PostgreSQL ====================
# Docker 和后端共用此环境配置
# 请设置自己的强密码；不要提交实际 .env 文件
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=yayi_0929

# ==================== Milvus ====================
# Docker 默认配置，通常无需修改
MILVUS_HOST=localhost
MILVUS_PORT=29530
MILVUS_DB_NAME=yayi_0929

# ==================== 知识库混合检索 ====================
# false 恢复原向量 Top-K + 重排路径；不改变集合结构或重新生成 embedding。
RETRIEVAL_HYBRID_ENABLED=true
RETRIEVAL_CANDIDATES=50
RETRIEVAL_RERANK_CANDIDATES=50
RETRIEVAL_RRF_K=60
BM25_K1=1.2
BM25_B=0.75
# 应用侧索引：同进程增删改立即失效；跨进程最迟在 TTL 到期后按需刷新。
BM25_CACHE_TTL_SECONDS=60
BM25_CACHE_ENTRIES=2
# 超预算显式降级到向量；不将部分扫描伪装成全库 BM25。
BM25_MAX_CHUNKS=50000
BM25_MAX_POSTINGS=2000000
BM25_BUILD_TIMEOUT_SECONDS=30

# ==================== JWT 认证 ====================
# 建议生成一个随机密钥，生产环境务必修改
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== 其他配置 ====================
MEM_LIMIT=8073741824
TIMEZONE=Asia/Shanghai

# YAYI_0929 independent application state on the existing local services
APP_PORT=8029
REDIS_DB=9
CORS_ALLOW_ORIGINS=http://localhost:5199,http://127.0.0.1:5199
NEWS_COLLECTION_ENABLED=false
LITERATURE_MIN_PAPERS=60
